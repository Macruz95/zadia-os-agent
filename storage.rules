rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to check file size (max 10MB)
    function isValidFileSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }
    
    // Helper to check allowed content types
    function isValidContentType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('application/pdf') ||
             request.resource.contentType.matches('application/vnd.openxmlformats.*') ||
             request.resource.contentType.matches('application/msword') ||
             request.resource.contentType.matches('text/.*');
    }

    // Check if user is a member of the specified tenant
    function isTenantMember(tenantId) {
      return isAuthenticated() &&
        tenantId != null &&
        firestore.exists(/databases/(default)/documents/tenantMembers/$(tenantId + '_' + request.auth.uid));
    }

    // Check if user is the owner of a tenant
    function isTenantOwner(tenantId) {
      return isAuthenticated() &&
        tenantId != null &&
        firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
    }

    // Check if user has access to tenant (member or owner)
    function hasTenantAccess(tenantId) {
      return isTenantMember(tenantId) || isTenantOwner(tenantId);
    }
    
    // User profile images - users can only access their own files
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidFileSize();
    }
    
    // Tenant-scoped files - validated tenant membership
    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if isAuthenticated() && hasTenantAccess(tenantId);
      allow write: if isAuthenticated() && hasTenantAccess(tenantId) && isValidFileSize() && isValidContentType();
    }
    
    // Project files - nested under tenants for proper isolation
    match /projects/{projectId}/{allPaths=**} {
      // Projects require authentication; full tenant check via Firestore project doc
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidFileSize() && isValidContentType();
    }
    
    // Client files - nested under tenants for proper isolation
    match /clients/{clientId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidFileSize() && isValidContentType();
    }
    
    // Invoice/Quote attachments
    match /invoices/{invoiceId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidFileSize() && isValidContentType();
    }
    
    match /quotes/{quoteId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidFileSize() && isValidContentType();
    }
    
    // Temp uploads - authenticated users for their own temp files only
    match /temp/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId && isValidFileSize();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Public assets (logos, etc) - read-only
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Default deny for any other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}